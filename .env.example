# Copiar como .env y rellenar con tus valores reales

NODE_ENV=production

# Supabase (pooler, puerto 6543). La usa la API en runtime.
# Obtén los valores en: Supabase > Project Settings > Database > Connection string > Transaction pooler
PROYECTO5_DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=proyecto5"

# Supabase (conexión directa, puerto 5432). La usan Prisma CLI y las migraciones.
# Obtén los valores en: Supabase > Project Settings > Database > Connection string > URI
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=proyecto5"

# Secreto para firmar los JWT (obligatorio en producción). Genera uno largo y aleatorio.
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"

# Vigencia del token en segundos (86400 = 24 horas)
JWT_EXPIRES_IN=86400

# Origen(es) del frontend separados por coma (obligatorio en producción).
# Ejemplo: "https://mi-app.vercel.app,https://mi-app-git-main.vercel.app"
FRONTEND_ORIGIN="https://TU-FRONTEND.vercel.app"

# Puerto del backend (Render lo inyecta automáticamente; 3000 por defecto)
PORT=3000
