# Copiar como .env y rellenar con tus valores reales

NODE_ENV=production

# Cadena de conexión a PostgreSQL (esquema proyecto5)
PROYECTO5_DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/NOMBRE_DB?schema=proyecto5"

# Secreto para firmar los JWT (obligatorio en producción)
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"

# Vigencia del token en segundos (86400 = 24 horas)
JWT_EXPIRES_IN=86400

# Origen(es) del frontend separados por coma (obligatorio en producción)
FRONTEND_ORIGIN="https://TU-FRONTEND.onrender.com"

# Puerto del backend
PORT=3000
